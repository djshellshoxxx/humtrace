{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:circuit-drift-labs:humtrace:analysis-report:1.2",
  "title": "HumTrace Analysis Report 1.2",
  "type": "object",
  "required": [
    "schema_version",
    "application",
    "input",
    "settings",
    "channels",
    "interpretation",
    "generator",
    "warnings"
  ],
  "properties": {
    "schema_version": {
      "const": "1.2"
    },
    "application": {
      "const": "HumTrace"
    },
    "input": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "sample_rate_hz",
        "channels",
        "bit_depth",
        "format_code",
        "duration_seconds",
        "bytes"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "sample_rate_hz": {
          "type": "integer",
          "minimum": 1
        },
        "channels": {
          "type": "integer",
          "minimum": 1
        },
        "bit_depth": {
          "type": "integer",
          "minimum": 1
        },
        "format_code": {
          "enum": [
            1,
            3
          ]
        },
        "duration_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "settings": {
      "type": "object",
      "required": [
        "window",
        "frame_size_samples",
        "hop_size_samples",
        "support_threshold_dbfs",
        "minimum_prominence_db",
        "tracker",
        "pipeline"
      ],
      "properties": {
        "window": {
          "const": "hann"
        },
        "frame_size_samples": {
          "type": "integer",
          "minimum": 4
        },
        "hop_size_samples": {
          "type": "integer",
          "minimum": 1
        },
        "support_threshold_dbfs": {
          "type": [
            "number",
            "null"
          ]
        },
        "minimum_prominence_db": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "tracker": {
          "type": "object",
          "required": [
            "fixed_hz_tolerance",
            "relative_tolerance",
            "bin_spacing_hz",
            "bin_fraction",
            "max_gap_frames",
            "min_observed_frames"
          ],
          "properties": {
            "fixed_hz_tolerance": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "relative_tolerance": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "bin_spacing_hz": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "bin_fraction": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "max_gap_frames": {
              "type": "integer",
              "minimum": 0
            },
            "min_observed_frames": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "pipeline": {
          "type": "object",
          "required": [
            "peak_min_level_dbfs",
            "peak_min_prominence_db",
            "max_peaks_per_frame",
            "max_harmonics",
            "dc_removed",
            "hop_fraction",
            "tail_window"
          ],
          "properties": {
            "peak_min_level_dbfs": {
              "type": [
                "number",
                "null"
              ]
            },
            "peak_min_prominence_db": {
              "type": [
                "number",
                "null"
              ]
            },
            "max_peaks_per_frame": {
              "type": "integer",
              "minimum": 1
            },
            "max_harmonics": {
              "type": "integer",
              "minimum": 1
            },
            "dc_removed": {
              "type": "boolean"
            },
            "hop_fraction": {
              "type": "number"
            },
            "tail_window": {
              "type": "string"
            }
          }
        }
      }
    },
    "channels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "channel_number",
          "frames",
          "tracks",
          "suppressed_tracks",
          "clipped_samples"
        ],
        "properties": {
          "channel_number": {
            "type": "integer",
            "minimum": 1
          },
          "frames": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "start_sample",
                "start_seconds",
                "strongest_peak",
                "mains_50_hz_measurements",
                "mains_60_hz_measurements"
              ],
              "properties": {
                "start_sample": {
                  "type": "integer",
                  "minimum": 0
                },
                "start_seconds": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0
                },
                "strongest_peak": {
                  "type": "object",
                  "required": [
                    "frequency_hz",
                    "level_dbfs"
                  ],
                  "properties": {
                    "frequency_hz": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "minimum": 0
                    },
                    "level_dbfs": {
                      "type": [
                        "number",
                        "null"
                      ]
                    }
                  }
                },
                "mains_50_hz_measurements": {
                  "$ref": "#/$defs/harmonicCandidate"
                },
                "mains_60_hz_measurements": {
                  "$ref": "#/$defs/harmonicCandidate"
                }
              }
            }
          },
          "tracks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "local_id",
                "first_frame",
                "last_frame",
                "observed_frames",
                "missing_frames",
                "median_frequency_hz",
                "median_level_dbfs",
                "drift_hz_per_second",
                "observations"
              ],
              "properties": {
                "local_id": {
                  "type": "integer",
                  "minimum": 1
                },
                "first_frame": {
                  "type": "integer",
                  "minimum": 0
                },
                "last_frame": {
                  "type": "integer",
                  "minimum": 0
                },
                "observed_frames": {
                  "type": "integer",
                  "minimum": 1
                },
                "missing_frames": {
                  "type": "integer",
                  "minimum": 0
                },
                "median_frequency_hz": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "median_level_dbfs": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "drift_hz_per_second": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "observations": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "frame_index",
                      "start_sample",
                      "frequency_hz",
                      "level_dbfs"
                    ],
                    "properties": {
                      "frame_index": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "start_sample": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "frequency_hz": {
                        "type": [
                          "number",
                          "null"
                        ]
                      },
                      "level_dbfs": {
                        "type": [
                          "number",
                          "null"
                        ]
                      }
                    }
                  }
                }
              }
            }
          },
          "suppressed_tracks": {
            "type": "integer",
            "minimum": 0
          },
          "clipped_samples": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "interpretation": {
      "type": "object",
      "required": [
        "source_classification",
        "note"
      ],
      "properties": {
        "source_classification": {
          "type": "null"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "generator": {
      "type": "object",
      "required": [
        "application_version",
        "method_version"
      ],
      "properties": {
        "application_version": {
          "type": "string"
        },
        "method_version": {
          "type": "string"
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "harmonicCandidate": {
      "type": "object",
      "required": [
        "nominal_frequency_hz",
        "supporting_harmonics",
        "harmonics"
      ],
      "properties": {
        "nominal_frequency_hz": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "supporting_harmonics": {
          "type": "integer",
          "minimum": 0
        },
        "harmonics": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "number",
              "expected_frequency_hz",
              "measured_bin_hz",
              "level_dbfs",
              "local_floor_dbfs",
              "prominence_db",
              "supported"
            ],
            "properties": {
              "number": {
                "type": "integer",
                "minimum": 1
              },
              "expected_frequency_hz": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "measured_bin_hz": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "level_dbfs": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "local_floor_dbfs": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "prominence_db": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "supported": {
                "type": "boolean"
              }
            }
          }
        }
      }
    }
  }
}
