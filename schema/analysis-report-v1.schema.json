{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:circuit-drift-labs:humtrace:analysis-report:1.2",
  "title": "HumTrace Analysis Report 1.2",
  "type": "object",
  "required": [
    "schema_version",
    "application",
    "input",
    "settings",
    "channels",
    "interpretation"
  ],
  "properties": {
    "schema_version": {
      "const": "1.2"
    },
    "application": {
      "const": "HumTrace"
    },
    "input": {
      "type": "object",
      "required": [
        "path",
        "sample_rate_hz",
        "channels",
        "bit_depth",
        "format_code",
        "duration_seconds"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "sample_rate_hz": {
          "type": "integer",
          "minimum": 1
        },
        "channels": {
          "type": "integer",
          "minimum": 1
        },
        "bit_depth": {
          "type": "integer",
          "minimum": 1
        },
        "format_code": {
          "enum": [
            1,
            3
          ]
        },
        "duration_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "settings": {
      "type": "object",
      "required": [
        "window",
        "frame_size_samples",
        "hop_size_samples",
        "support_threshold_dbfs",
        "minimum_prominence_db",
        "peak_tracking",
        "welch_psd"
      ],
      "properties": {
        "window": {
          "const": "hann"
        },
        "frame_size_samples": {
          "type": "integer",
          "minimum": 4
        },
        "hop_size_samples": {
          "type": "integer",
          "minimum": 1
        },
        "support_threshold_dbfs": {
          "type": [
            "number",
            "null"
          ]
        },
        "minimum_prominence_db": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "peak_tracking": {
          "type": "object",
          "required": [
            "peaks_per_frame",
            "dynamic_range_db",
            "exclusion_bins",
            "frequency_tolerance_hz",
            "max_gap_frames",
            "min_observed_frames"
          ],
          "properties": {
            "peaks_per_frame": {
              "type": "integer",
              "minimum": 1
            },
            "dynamic_range_db": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "exclusion_bins": {
              "type": "integer",
              "minimum": 0
            },
            "frequency_tolerance_hz": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "max_gap_frames": {
              "type": "integer",
              "minimum": 0
            },
            "min_observed_frames": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "welch_psd": {
          "anyOf": [
            {
              "type": "object",
              "required": [
                "window",
                "density_unit",
                "segment_size_samples",
                "hop_size_samples",
                "guard_bins",
                "radius_bins",
                "max_harmonics",
                "minimum_prominence_db"
              ],
              "properties": {
                "window": {
                  "const": "hann"
                },
                "density_unit": {
                  "const": "dBFS^2/Hz"
                },
                "segment_size_samples": {
                  "type": "integer",
                  "minimum": 4
                },
                "hop_size_samples": {
                  "type": "integer",
                  "minimum": 1
                },
                "guard_bins": {
                  "type": "integer",
                  "minimum": 0
                },
                "radius_bins": {
                  "type": "integer",
                  "minimum": 1
                },
                "max_harmonics": {
                  "type": "integer",
                  "minimum": 1
                },
                "minimum_prominence_db": {
                  "type": "number",
                  "minimum": 0
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "channels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "channel_number",
          "frames",
          "tracks",
          "psd"
        ],
        "properties": {
          "channel_number": {
            "type": "integer",
            "minimum": 1
          },
          "frames": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "start_sample",
                "start_seconds",
                "strongest_peak",
                "mains_50_hz_measurements",
                "mains_60_hz_measurements"
              ],
              "properties": {
                "start_sample": {
                  "type": "integer",
                  "minimum": 0
                },
                "start_seconds": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0
                },
                "strongest_peak": {
                  "type": "object",
                  "required": [
                    "frequency_hz",
                    "level_dbfs"
                  ],
                  "properties": {
                    "frequency_hz": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "minimum": 0
                    },
                    "level_dbfs": {
                      "type": [
                        "number",
                        "null"
                      ]
                    }
                  }
                },
                "mains_50_hz_measurements": {
                  "$ref": "#/$defs/harmonicCandidate"
                },
                "mains_60_hz_measurements": {
                  "$ref": "#/$defs/harmonicCandidate"
                }
              }
            }
          },
          "tracks": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/peakTrack"
            }
          },
          "psd": {
            "anyOf": [
              {
                "$ref": "#/$defs/psdSummary"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "interpretation": {
      "type": "object",
      "required": [
        "source_classification",
        "note"
      ],
      "properties": {
        "source_classification": {
          "type": "null"
        },
        "note": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "harmonicCandidate": {
      "type": "object",
      "required": [
        "nominal_frequency_hz",
        "supporting_harmonics",
        "harmonics"
      ],
      "properties": {
        "nominal_frequency_hz": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "supporting_harmonics": {
          "type": "integer",
          "minimum": 0
        },
        "harmonics": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "number",
              "expected_frequency_hz",
              "measured_bin_hz",
              "level_dbfs",
              "local_floor_dbfs",
              "prominence_db",
              "supported"
            ],
            "properties": {
              "number": {
                "type": "integer",
                "minimum": 1
              },
              "expected_frequency_hz": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "measured_bin_hz": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "level_dbfs": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "local_floor_dbfs": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "prominence_db": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "supported": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "peakTrack": {
      "type": "object",
      "required": [
        "track_number",
        "start_sample",
        "start_seconds",
        "end_sample",
        "end_seconds",
        "observed_frames",
        "missing_frames",
        "mean_frequency_hz",
        "min_frequency_hz",
        "max_frequency_hz",
        "mean_level_dbfs",
        "max_level_dbfs",
        "frequency_drift_hz",
        "drift_rate_hz_per_second",
        "source_classification",
        "observations"
      ],
      "properties": {
        "track_number": {
          "type": "integer",
          "minimum": 1
        },
        "start_sample": {
          "type": "integer",
          "minimum": 0
        },
        "start_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "end_sample": {
          "type": "integer",
          "minimum": 0
        },
        "end_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "observed_frames": {
          "type": "integer",
          "minimum": 1
        },
        "missing_frames": {
          "type": "integer",
          "minimum": 0
        },
        "mean_frequency_hz": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "min_frequency_hz": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "max_frequency_hz": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "mean_level_dbfs": {
          "type": [
            "number",
            "null"
          ]
        },
        "max_level_dbfs": {
          "type": [
            "number",
            "null"
          ]
        },
        "frequency_drift_hz": {
          "type": [
            "number",
            "null"
          ]
        },
        "drift_rate_hz_per_second": {
          "type": [
            "number",
            "null"
          ]
        },
        "source_classification": {
          "type": "null"
        },
        "observations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "start_sample",
              "start_seconds",
              "frequency_hz",
              "level_dbfs",
              "prominence_db"
            ],
            "properties": {
              "start_sample": {
                "type": "integer",
                "minimum": 0
              },
              "start_seconds": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "frequency_hz": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "level_dbfs": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "prominence_db": {
                "type": [
                  "number",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "psdHarmonic": {
      "type": "object",
      "required": [
        "number",
        "expected_frequency_hz",
        "measured_bin_hz",
        "level_dbfs2_per_hz",
        "local_floor_dbfs2_per_hz",
        "prominence_db",
        "prominent"
      ],
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "expected_frequency_hz": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "measured_bin_hz": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "level_dbfs2_per_hz": {
          "type": [
            "number",
            "null"
          ]
        },
        "local_floor_dbfs2_per_hz": {
          "type": [
            "number",
            "null"
          ]
        },
        "prominence_db": {
          "type": [
            "number",
            "null"
          ]
        },
        "prominent": {
          "type": "boolean"
        }
      }
    },
    "psdHarmonicCandidate": {
      "type": "object",
      "required": [
        "nominal_frequency_hz",
        "prominent_harmonics",
        "harmonics"
      ],
      "properties": {
        "nominal_frequency_hz": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "prominent_harmonics": {
          "type": "integer",
          "minimum": 0
        },
        "harmonics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/psdHarmonic"
          }
        }
      }
    },
    "psdSummary": {
      "type": "object",
      "required": [
        "segments_averaged",
        "samples_processed",
        "bin_width_hz",
        "density_unit",
        "broadband_median_dbfs2_per_hz",
        "source_classification",
        "mains_50_hz_psd",
        "mains_60_hz_psd"
      ],
      "properties": {
        "segments_averaged": {
          "type": "integer",
          "minimum": 1
        },
        "samples_processed": {
          "type": "integer",
          "minimum": 0
        },
        "bin_width_hz": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "density_unit": {
          "const": "dBFS^2/Hz"
        },
        "broadband_median_dbfs2_per_hz": {
          "type": [
            "number",
            "null"
          ]
        },
        "source_classification": {
          "type": "null"
        },
        "mains_50_hz_psd": {
          "$ref": "#/$defs/psdHarmonicCandidate"
        },
        "mains_60_hz_psd": {
          "$ref": "#/$defs/psdHarmonicCandidate"
        }
      }
    }
  }
}
